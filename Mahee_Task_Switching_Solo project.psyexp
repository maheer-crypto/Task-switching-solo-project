            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="MainTrial"/>
        <LoopTerminator name="main_loop"/>
        <Routine name="End"/>
    </Flow>
</PsychoPy2experiment>